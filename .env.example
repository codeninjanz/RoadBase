APP_NAME=RoadBase
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Pacific/Auckland
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=roadbase
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_PLACES_KEY=

NZTA_TMS_FEATURE_URL=https://services.arcgis.com/CXBb7LAjgIIdcsPt/arcgis/rest/services/TMS_Telemetry_Sites/FeatureServer/0
NZTA_AADT_FEATURE_URL=https://services.arcgis.com/CXBb7LAjgIIdcsPt/arcgis/rest/services/Assets_SHTrafficMonitoringSites/FeatureServer/0
NZTA_AADT_LINES_URL=
NSLR_FEATURE_URL=https://services.arcgis.com/CXBb7LAjgIIdcsPt/arcgis/rest/services/SpeedLimitZoneFull__View/FeatureServer/0

# Stats NZ Territorial Authority polygons (RCA boundaries fallback).
# Public ArcGIS Online FeatureServer published by StatsNZGeospatial.
# Bump the year suffix when a newer vintage is published.
STATS_NZ_TA_URL=https://services2.arcgis.com/vKb0s8tBIA3bdocZ/arcgis/rest/services/Territorial_Authority_2026/FeatureServer/0

# NZ Roads centrelines (national, RCA-attributed). Published by NZTA on the
# Geospatial Roading Open Data Hub. Provides every road maintained by every
# Road Controlling Authority on the mobileroad.org list — Auckland Transport,
# council DCs/CCs, DOC, KiwiRail crossings, etc. Leave blank to skip the sync;
# fill in the published FeatureServer layer query URL to ingest. Field names
# are auto-detected (roadSectionId/roadName/rcaName/hierarchy with aliases).
NZ_ROADS_CENTRELINES_URL=

# ----------------------------------------------------------------------------
# Council / district-council traffic-count FeatureServer URLs.
#
# Each one is an ArcGIS FeatureServer *layer query* URL (point features
# carrying AADT / ADT) — i.e. ending in /FeatureServer/0 (or another layer
# index). Field names are auto-detected from a list of common aliases —
# see config/council_sources.php. Blank URLs no-op cheaply; the DataSource
# row still appears on /about as a known feed.
#
# Verify any URL you paste before running a sync:
#     php artisan councils:probe                # tests every configured URL
#     php artisan councils:probe at_adt         # tests one
#
# Most RCAs publish (if at all) via an ArcGIS Hub. Hub URLs that have been
# verified to exist are listed inline below — open the hub, find the
# "Traffic Counts" / "AADT" / "ADT" point dataset, and copy the
# *FeatureServer layer query URL* from its API endpoints panel.
#
# IMPORTANT: most councils on the mobileroad.org list do NOT publish counts
# publicly (mobileroad.org pulls from RAMM, a closed system). Expect to fill
# in 5-15 of these, not all 60+.
# ----------------------------------------------------------------------------

# Auckland Transport — hub: https://data-atgis.opendata.arcgis.com/
# Look for "Average Daily Traffic Counts".
AT_ADT_FEATURE_URL=

# Hamilton CC — confirmed FeatureServer URL (from data.govt.nz catalogue).
# ~150 sites, refreshed annually. Hub: https://data-waikatolass.opendata.arcgis.com/
HCC_FEATURE_URL=https://services1.arcgis.com/R6s0QqCMQdwKY6yp/arcgis/rest/services/Hamilton%20City%20Traffic%20Counts/FeatureServer/0

# Christchurch CC — hub: https://opendata-christchurchcity.hub.arcgis.com/
# Also direct service catalog: https://gis.ccc.govt.nz/arcgis/rest/services/OpenData
CCC_FEATURE_URL=

# Wellington CC — hub: https://data-wcc.opendata.arcgis.com/
WELLINGTON_CC_FEATURE_URL=

# Hutt CC — hub: https://open-data-huttcity.hub.arcgis.com/
HUTT_CC_FEATURE_URL=

# Upper Hutt CC — hub: https://open-data-uhcc.hub.arcgis.com/
UPPER_HUTT_CC_FEATURE_URL=

PORIRUA_CC_FEATURE_URL=
KAPITI_COAST_DC_FEATURE_URL=

# Tauranga CC — services dir: https://mapi.tauranga.govt.nz/arcgis/rest/services/MapiServices/Transportation_/MapServer
# Their transport MapServer exposes "Traffic Count Sites" and "Traffic By Site
# Latest Count" sub-layers; you'll need the FeatureServer mirror or the
# specific MapServer layer URL.
TAURANGA_CC_FEATURE_URL=

WESTERN_BOP_DC_FEATURE_URL=
ROTORUA_DC_FEATURE_URL=

